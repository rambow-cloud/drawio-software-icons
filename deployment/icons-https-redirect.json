{
  "name": "Redirect rules",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "icons_http_to_https",
      "description": "Redirect icons.rambow.cloud HTTP URLs to their HTTPS equivalents",
      "expression": "(http.host eq \"icons.rambow.cloud\" and not ssl)",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://icons.rambow.cloud\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
